<Window x:Class="DirectorFamilyTravelDesk.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Management Travel Tracker" Width="1440" Height="860" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Nav}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="18,22,18,16">
     <TextBlock Text="MANAGEMENT" Foreground="#AAB5C6" FontSize="11" FontWeight="SemiBold"/>
     <TextBlock Text="Travel Tracker" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/>
     <TextBlock Text="Domestic travel workspace" Foreground="#91A0B5" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel>
     <Button Content="Dashboard" Style="{StaticResource NavButton}" Click="Dashboard_Click"/>
     <Button Content="Trips" Style="{StaticResource NavButton}" Click="Trips_Click"/>
     <Button Content="Flights" Style="{StaticResource NavButton}" Click="Flights_Click"/>
     <Button Content="Hotels" Style="{StaticResource NavButton}" Click="Hotels_Click"/>
     <Button Content="Cabs" Style="{StaticResource NavButton}" Click="Cabs_Click"/>
     <Button Content="Travellers" Style="{StaticResource NavButton}" Click="Travellers_Click"/>
     <Button Content="Cities" Style="{StaticResource NavButton}" Click="Cities_Click"/>
     <Button Content="Routes" Style="{StaticResource NavButton}" Click="Routes_Click"/>
     <Button Content="Backup / Export" Style="{StaticResource NavButton}" Click="Backup_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,20">
     <TextBlock Text="SQLite • Offline • Single user" Foreground="#7F8CA1" FontSize="10"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ContentControl Grid.Column="1" x:Name="MainContent"/>
 </Grid>
</Window>