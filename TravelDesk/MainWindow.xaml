<Window x:Class="DirectorFamilyTravelDesk.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Management Travel Tracker" Width="1480" Height="900" MinWidth="1220" MinHeight="740"
 WindowStartupLocation="CenterScreen" Icon="Assets/ManagementTravelTracker.ico">
 <Grid Background="{StaticResource Bg}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
     <StackPanel Orientation="Horizontal">
      <Border Width="48" Height="48" CornerRadius="12" Background="#132849" Margin="0,0,10,0">
       <Image Source="Assets/ManagementTravelTracker.ico" Width="40" Height="40" Stretch="Uniform"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="Management" FontSize="12" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
       <TextBlock Text="Travel Tracker" FontSize="21" Foreground="{StaticResource Text}" FontWeight="Bold"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Text="Domestic travel operations" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,7,0,0"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="OVERVIEW" Style="{StaticResource NavSectionLabel}"/>
      <Button Content="Dashboard" Style="{StaticResource NavButton}" Click="Dashboard_Click"/>
      <Button Content="Trip Register" Style="{StaticResource NavButton}" Click="Trips_Click"/>

      <TextBlock Text="TRAVEL OPERATIONS" Style="{StaticResource NavSectionLabel}"/>
      <Button Content="Flights" Style="{StaticResource NavButton}" Click="Flights_Click"/>
      <Button Content="Hotels" Style="{StaticResource NavButton}" Click="Hotels_Click"/>
      <Button Content="Cabs / Transfers" Style="{StaticResource NavButton}" Click="Cabs_Click"/>

      <TextBlock Text="MASTERS" Style="{StaticResource NavSectionLabel}"/>
      <Button Content="Travellers" Style="{StaticResource NavButton}" Click="Travellers_Click"/>
      <Button Content="Cities" Style="{StaticResource NavButton}" Click="Cities_Click"/>
      <Button Content="Routes" Style="{StaticResource NavButton}" Click="Routes_Click"/>

      <TextBlock Text="DATA" Style="{StaticResource NavSectionLabel}"/>
      <Button Content="Backup / Export" Style="{StaticResource NavButton}" Click="Backup_Click"/>
     </StackPanel>
    </ScrollViewer>

    <Border DockPanel.Dock="Bottom" Margin="14" Padding="12" CornerRadius="10" Background="#F6F9FD" BorderBrush="{StaticResource Border}" BorderThickness="1">
     <StackPanel>
      <TextBlock Text="LOCAL &amp; SECURE" Foreground="{StaticResource Good}" FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="SQLite • Offline • Single user" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
     </StackPanel>
    </Border>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{StaticResource TopBar}">
    <Grid Margin="24,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="Management Travel Tracker" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
      <Border Background="#2B467A" CornerRadius="10" Padding="9,4" Margin="14,0,0,0">
       <TextBlock Text="DOMESTIC" Foreground="#DCE6FF" FontSize="10" FontWeight="Bold"/>
      </Border>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse Width="9" Height="9" Fill="#5ED6A8" Margin="0,0,7,0"/>
      <TextBlock Text="Local database ready" Foreground="#D9E5F5" FontSize="11"/>
     </StackPanel>
    </Grid>
   </Border>

   <Border Grid.Row="1" Background="{StaticResource Bg}">
    <ContentControl x:Name="MainContent"/>
   </Border>
  </Grid>
 </Grid>
</Window>