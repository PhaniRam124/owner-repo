<UserControl x:Class="DirectorFamilyTravelDesk.Views.CitiesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel>
    <TextBlock Text="Cities" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="Maintain city master and IATA codes" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
   </StackPanel>
   <Border DockPanel.Dock="Right" Background="{StaticResource PrimarySoft}" CornerRadius="8" Padding="10,6">
    <TextBlock x:Name="ModeText" Text="NEW CITY" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
   </Border>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,14">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <TextBlock Text="CITY NAME" Style="{StaticResource SmallLabel}"/>
    <TextBlock Grid.Column="1" Text="IATA CODE" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBox Grid.Row="1" x:Name="NameBox" Margin="0,6,0,0" MinHeight="38"/>
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="IataBox" Margin="12,6,0,0" MaxLength="3" MinHeight="38"/>
    <CheckBox Grid.Row="1" Grid.Column="2" x:Name="ActiveBox" Content="Active" IsChecked="True" VerticalAlignment="Center" Margin="12,6,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
    <Button Content="+ New" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="New_Click"/>
    <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="Delete_Click"/>
    <Button x:Name="SaveButton" Content="Save City" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
   </StackPanel>
   <DataGrid Grid.Row="1" x:Name="Grid" SelectionChanged="Grid_SelectionChanged" SelectionMode="Single">
    <DataGrid.Columns>
     <DataGridTextColumn Header="City" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="IATA" Binding="{Binding Iata}" Width="140"/>
     <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="90"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
 </Grid>
</UserControl>