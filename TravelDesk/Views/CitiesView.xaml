<UserControl x:Class="DirectorFamilyTravelDesk.Views.CitiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Cities" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="NameBox" ToolTip="City name"/><TextBox Grid.Column="1" x:Name="IataBox" Margin="8,0,0,0" ToolTip="IATA" MaxLength="3"/><CheckBox Grid.Column="2" x:Name="ActiveBox" Content="Active" IsChecked="True" VerticalAlignment="Center" Margin="12,0"/><Button Grid.Column="3" Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></Grid><DataGrid Grid.Row="2" x:Name="Grid" SelectionChanged="Grid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="City" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="IATA" Binding="{Binding Iata}" Width="100"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/></DataGrid.Columns></DataGrid></Grid></UserControl>