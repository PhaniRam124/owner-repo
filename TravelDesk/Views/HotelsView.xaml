<UserControl x:Class="DirectorFamilyTravelDesk.Views.HotelsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel><TextBlock Text="Hotel Bookings" Style="{StaticResource SectionTitle}"/><TextBlock Text="Domestic hotel confirmations linked to each trip" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
   <Border DockPanel.Dock="Right" Background="{StaticResource PrimarySoft}" CornerRadius="8" Padding="10,6"><TextBlock x:Name="ModeText" Text="NEW HOTEL BOOKING" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/></Border>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,14">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <TextBlock Text="TRIP" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1" Text="HOTEL NAME" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Column="2" Text="CITY" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Column="3" Text="CHECK-IN" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Column="4" Text="CHECK-OUT" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <ComboBox Grid.Row="1" x:Name="TripBox" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" Margin="0,6,0,10"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="HotelNameBox" Margin="12,6,0,10"/><TextBox Grid.Row="1" Grid.Column="2" x:Name="CityBox" Margin="12,6,0,10"/><DatePicker Grid.Row="1" Grid.Column="3" x:Name="CheckInBox" Margin="12,6,0,10"/><DatePicker Grid.Row="1" Grid.Column="4" x:Name="CheckOutBox" Margin="12,6,0,10"/>
    <TextBlock Grid.Row="2" Text="BOOKING SOURCE" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="BOOKING / MMT REF" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="CONFIRMATION NO" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Row="2" Grid.Column="3" Text="ROOM TYPE" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Row="2" Grid.Column="4" Text="AMOUNT" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBox Grid.Row="3" x:Name="SourceBox" Text="MakeMyTrip" Margin="0,6,0,0"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="BookingRefBox" Margin="12,6,0,0"/><TextBox Grid.Row="3" Grid.Column="2" x:Name="ConfirmationBox" Margin="12,6,0,0"/><TextBox Grid.Row="3" Grid.Column="3" x:Name="RoomTypeBox" Margin="12,6,0,0"/><TextBox Grid.Row="3" Grid.Column="4" x:Name="AmountBox" Margin="12,6,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
    <Button Content="+ New" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="New_Click"/>
    <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="Delete_Click"/>
    <Button x:Name="SaveButton" Content="Save Hotel" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
   </StackPanel>
   <DataGrid Grid.Row="1" x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Trip" Binding="{Binding TripCode}" Width="115"/><DataGridTextColumn Header="Hotel" Binding="{Binding HotelName}" Width="*"/><DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/><DataGridTextColumn Header="Stay" Binding="{Binding DateRange}" Width="145"/><DataGridTextColumn Header="Source" Binding="{Binding BookingSource}" Width="110"/><DataGridTextColumn Header="Reference" Binding="{Binding BookingRef}" Width="150"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount,StringFormat=₹{0:N0}}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
 </Grid>
</UserControl>