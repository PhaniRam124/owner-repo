<UserControl x:Class="DirectorFamilyTravelDesk.Views.TravellersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Travellers" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="CodeBox" ToolTip="Short form"/><TextBox Grid.Column="1" x:Name="FullBox" Margin="8,0,0,0" ToolTip="Full name (optional)"/><TextBox Grid.Column="2" x:Name="GroupBox" Margin="8,0,0,0" ToolTip="Relation / Group" Text="Family"/><CheckBox Grid.Column="3" x:Name="ActiveBox" Content="Active" IsChecked="True" VerticalAlignment="Center" Margin="10,0"/><Button Grid.Column="4" Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></Grid><DataGrid Grid.Row="2" x:Name="Grid" SelectionChanged="Grid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Short" Binding="{Binding ShortCode}" Width="90"/><DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="Relation / Group" Binding="{Binding RelationGroup}" Width="180"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/></DataGrid.Columns></DataGrid></Grid></UserControl>