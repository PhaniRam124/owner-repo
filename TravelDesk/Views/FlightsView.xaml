<UserControl x:Class="DirectorFamilyTravelDesk.Views.FlightsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Flights" Style="{StaticResource SectionTitle}"/><Grid Grid.Row="1" Margin="0,16,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="95"/><ColumnDefinition Width="95"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBox x:Name="AirlineBox" ToolTip="Airline"/><TextBox Grid.Column="1" x:Name="FlightNoBox" Margin="8,0,0,0" ToolTip="Flight no"/><ComboBox Grid.Column="2" x:Name="RouteBox" Margin="8,0,0,0" DisplayMemberPath="RouteLabel" SelectedValuePath="Id"/><TextBox Grid.Column="3" x:Name="DepBox" Margin="8,0,0,0" ToolTip="HH:mm"/><TextBox Grid.Column="4" x:Name="ArrBox" Margin="8,0,0,0" ToolTip="HH:mm"/><TextBox Grid.Column="5" x:Name="StopsBox" Margin="8,0,0,0" Text="0" ToolTip="Stops"/></Grid><Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="ViaBox" ToolTip="Via IATA (only for connection)"/><CheckBox Grid.Column="1" x:Name="ActiveBox" Content="Active" IsChecked="True" VerticalAlignment="Center" Margin="10,0"/><ComboBox Grid.Column="2" x:Name="FilterRoute" Margin="8,0,8,0" DisplayMemberPath="RouteLabel" SelectedValuePath="Id" SelectionChanged="FilterRoute_Changed"/><Button Grid.Column="3" Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></Grid><DataGrid Grid.Row="3" x:Name="Grid" SelectionChanged="Grid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Airline" Binding="{Binding Airline}" Width="160"/><DataGridTextColumn Header="Flight" Binding="{Binding FlightNo}" Width="120"/><DataGridTextColumn Header="Route" Binding="{Binding RouteCode}" Width="100"/><DataGridTextColumn Header="Dep" Binding="{Binding DepartureTime}" Width="80"/><DataGridTextColumn Header="Arr" Binding="{Binding ArrivalTime}" Width="80"/><DataGridTextColumn Header="Stops" Binding="{Binding Stops}" Width="60"/><DataGridTextColumn Header="Via" Binding="{Binding ViaIata}" Width="70"/><DataGridTextColumn Header="Dropdown Value" Binding="{Binding DisplayValue}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid></Grid></UserControl>