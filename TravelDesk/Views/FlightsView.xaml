<UserControl x:Class="DirectorFamilyTravelDesk.Views.FlightsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel><TextBlock Text="Flights" Style="{StaticResource SectionTitle}"/><TextBlock Text="Maintain route-specific scheduled flights" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
   <Border DockPanel.Dock="Right" Background="{StaticResource PrimarySoft}" CornerRadius="8" Padding="10,6"><TextBlock x:Name="ModeText" Text="NEW FLIGHT" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/></Border>
  </DockPanel>

  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,12">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <TextBlock Text="AIRLINE" Style="{StaticResource SmallLabel}"/>
    <TextBlock Grid.Column="1" Text="FLIGHT NO" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBlock Grid.Column="2" Text="ROUTE" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBlock Grid.Column="3" Text="DEPART" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBlock Grid.Column="4" Text="ARRIVE" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBlock Grid.Column="5" Text="STOPS" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBlock Grid.Column="6" Text="VIA IATA" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>

    <TextBox Grid.Row="1" x:Name="AirlineBox" Margin="0,6,0,0" MinHeight="38"/>
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="FlightNoBox" Margin="12,6,0,0" MinHeight="38"/>
    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="RouteBox" Margin="12,6,0,0" DisplayMemberPath="RouteLabel" SelectedValuePath="Id" MinHeight="38"/>
    <TextBox Grid.Row="1" Grid.Column="3" x:Name="DepBox" Margin="12,6,0,0" ToolTip="HH:mm" MinHeight="38"/>
    <TextBox Grid.Row="1" Grid.Column="4" x:Name="ArrBox" Margin="12,6,0,0" ToolTip="HH:mm" MinHeight="38"/>
    <TextBox Grid.Row="1" Grid.Column="5" x:Name="StopsBox" Margin="12,6,0,0" Text="0" MinHeight="38"/>
    <TextBox Grid.Row="1" Grid.Column="6" x:Name="ViaBox" Margin="12,6,0,0" ToolTip="Connection airport, e.g. HYD" MinHeight="38"/>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,12,0,0">
     <CheckBox x:Name="ActiveBox" Content="Active" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
     <TextBlock Text="For a connecting flight, set Stops = 1 and enter the Via IATA code." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="FILTER" Style="{StaticResource SmallLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="FilterRoute" Width="280" DisplayMemberPath="RouteLabel" SelectedValuePath="Id" SelectionChanged="FilterRoute_Changed"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="+ New" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="New_Click"/>
    <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="Delete_Click"/>
    <Button x:Name="SaveButton" Content="Save Flight" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
   </StackPanel>
  </Grid>

  <DataGrid Grid.Row="3" x:Name="Grid" SelectionChanged="Grid_SelectionChanged" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Airline" Binding="{Binding Airline}" Width="150"/>
    <DataGridTextColumn Header="Flight" Binding="{Binding FlightNo}" Width="110"/>
    <DataGridTextColumn Header="Route" Binding="{Binding RouteCode}" Width="105"/>
    <DataGridTextColumn Header="Dep" Binding="{Binding DepartureTime}" Width="75"/>
    <DataGridTextColumn Header="Arr" Binding="{Binding ArrivalTime}" Width="75"/>
    <DataGridTextColumn Header="Stops" Binding="{Binding Stops}" Width="65"/>
    <DataGridTextColumn Header="Via" Binding="{Binding ViaIata}" Width="75"/>
    <DataGridTextColumn Header="Display" Binding="{Binding DisplayValue}" Width="*"/>
    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>