<UserControl x:Class="DirectorFamilyTravelDesk.Views.CabsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel><TextBlock Text="Cab Bookings" Style="{StaticResource SectionTitle}"/><TextBlock Text="Airport transfers, local cabs and hotel pickups linked to each trip" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
   <Border DockPanel.Dock="Right" Background="{StaticResource PrimarySoft}" CornerRadius="8" Padding="10,6"><TextBlock x:Name="ModeText" Text="NEW CAB BOOKING" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/></Border>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,14">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <TextBlock Text="TRIP" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1" Text="DATE / TIME" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Column="2" Text="PICKUP" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Column="3" Text="DROP" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Column="4" Text="PROVIDER" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <ComboBox Grid.Row="1" x:Name="TripBox" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" Margin="0,6,0,10"/><Grid Grid.Row="1" Grid.Column="1" Margin="12,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><DatePicker x:Name="DateBox"/><TextBox Grid.Column="1" x:Name="TimeBox" Margin="6,0,0,0" ToolTip="HH:mm"/></Grid><TextBox Grid.Row="1" Grid.Column="2" x:Name="PickupBox" Margin="12,6,0,10"/><TextBox Grid.Row="1" Grid.Column="3" x:Name="DropBox" Margin="12,6,0,10"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="ProviderBox" Margin="12,6,0,10"/>
    <TextBlock Grid.Row="2" Text="BOOKING SOURCE" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="BOOKING / MMT REF" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="VEHICLE TYPE" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Row="2" Grid.Column="3" Text="AMOUNT" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/><TextBlock Grid.Row="2" Grid.Column="4" Text="STATUS" Style="{StaticResource SmallLabel}" Margin="12,0,0,0"/>
    <TextBox Grid.Row="3" x:Name="SourceBox" Text="MakeMyTrip" Margin="0,6,0,0"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="BookingRefBox" Margin="12,6,0,0"/><TextBox Grid.Row="3" Grid.Column="2" x:Name="VehicleBox" Margin="12,6,0,0"/><TextBox Grid.Row="3" Grid.Column="3" x:Name="AmountBox" Margin="12,6,0,0"/><ComboBox Grid.Row="3" Grid.Column="4" x:Name="StatusBox" Margin="12,6,0,0"><ComboBoxItem Content="To Confirm"/><ComboBoxItem Content="Booked"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/></ComboBox>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10"><Button Content="+ New" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="New_Click"/><Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="Delete_Click"/><Button x:Name="SaveButton" Content="Save Cab" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
   <DataGrid Grid.Row="1" x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
    <DataGrid.Columns><DataGridTextColumn Header="Trip" Binding="{Binding TripCode}" Width="115"/><DataGridTextColumn Header="Date" Binding="{Binding TravelDate,StringFormat=dd-MMM-yyyy}" Width="115"/><DataGridTextColumn Header="Time" Binding="{Binding PickupTime}" Width="75"/><DataGridTextColumn Header="Pickup → Drop" Binding="{Binding Route}" Width="*"/><DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="120"/><DataGridTextColumn Header="Source" Binding="{Binding BookingSource}" Width="110"/><DataGridTextColumn Header="Reference" Binding="{Binding BookingRef}" Width="150"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount,StringFormat=₹{0:N0}}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/></DataGrid.Columns>
   </DataGrid>
  </Grid>
 </Grid>
</UserControl>