<UserControl x:Class="DirectorFamilyTravelDesk.Views.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Margin="28"><TextBlock Text="Backup / Export" Style="{StaticResource SectionTitle}"/><TextBlock Text="The app stores data locally in SQLite. Backups are normal database copies." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DATABASE LOCATION" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="PathText" TextWrapping="Wrap" Margin="0,5,0,14"/><WrapPanel><Button Content="Backup Database" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Backup_Click"/><Button Content="Export Trips CSV" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Export_Click"/><Button Content="Open Data Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenFolder_Click"/><Button Content="Open Reference Workbook" Style="{StaticResource SecondaryButton}" Click="OpenReference_Click"/></WrapPanel></StackPanel></Border><TextBlock x:Name="ResultText" Foreground="{StaticResource Good}" Margin="4,8,0,0"/></StackPanel></UserControl>