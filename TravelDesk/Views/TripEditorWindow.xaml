<Window x:Class="DirectorFamilyTravelDesk.Views.TripEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Trip" Width="880" Height="760" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"><ScrollViewer><StackPanel Margin="24">
<DockPanel Margin="0,0,0,18"><TextBlock x:Name="TitleText" Text="New Trip" Style="{StaticResource SectionTitle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Save Trip" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="TRIP ID" Style="{StaticResource SmallLabel}"/><TextBox x:Name="TripCode"/></StackPanel><StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="TRIP TYPE" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="TripType" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="ROUTE" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="Route" DisplayMemberPath="RouteLabel" SelectedValuePath="Id" SelectionChanged="Route_Changed"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="STATUS" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="Status" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
<StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="DEPARTURE" Style="{StaticResource SmallLabel}"/><DatePicker x:Name="Departure"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="RETURN" Style="{StaticResource SmallLabel}"/><DatePicker x:Name="ReturnDate"/></StackPanel>
<StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="HOTEL" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="Hotel" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="TRANSPORT" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="Transport" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
<StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,12"><TextBlock Text="TOTAL COST" Style="{StaticResource SmallLabel}"/><TextBox x:Name="TotalCost"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,12"><TextBlock Text="TRANSPORT DETAILS" Style="{StaticResource SmallLabel}"/><TextBox x:Name="TransportDetails"/></StackPanel>
</Grid>
<TextBlock Text="TRAVELLERS" Style="{StaticResource SmallLabel}"/><Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,14"><ItemsControl x:Name="TravellerList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" Margin="6" MinWidth="130"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,12"><StackPanel><TextBlock Text="ONWARD" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="FLIGHT" Style="{StaticResource SmallLabel}" Margin="0,10,0,0"/><ComboBox x:Name="OnwardFlight" DisplayMemberPath="DisplayValue" SelectedValuePath="Id"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="PNR" Style="{StaticResource SmallLabel}"/><TextBox x:Name="OnwardPnr"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="SEATS" Style="{StaticResource SmallLabel}"/><TextBox x:Name="OnwardSeats"/></StackPanel></Grid></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,12"><StackPanel><TextBlock Text="RETURN" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="FLIGHT" Style="{StaticResource SmallLabel}" Margin="0,10,0,0"/><ComboBox x:Name="ReturnFlight" DisplayMemberPath="DisplayValue" SelectedValuePath="Id"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="PNR" Style="{StaticResource SmallLabel}"/><TextBox x:Name="ReturnPnr"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="SEATS" Style="{StaticResource SmallLabel}"/><TextBox x:Name="ReturnSeats"/></StackPanel></Grid></StackPanel></Border>
</Grid>
<TextBlock Text="REMARKS" Style="{StaticResource SmallLabel}"/><TextBox x:Name="Remarks" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Window>