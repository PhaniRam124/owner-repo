<UserControl x:Class="DirectorFamilyTravelDesk.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
    <DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="Travel Dashboard" Style="{StaticResource SectionTitle}"/><TextBlock Text="Fast reference, approval tracking and upcoming travel" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="+ New Trip" Style="{StaticResource PrimaryButton}" Click="NewTrip_Click" Width="110"/></DockPanel>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="VIEW" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="ViewFilter" SelectionChanged="Filter_Changed"><ComboBoxItem Content="Active Trips"/><ComboBoxItem Content="All Trips"/><ComboBoxItem Content="Upcoming"/><ComboBoxItem Content="Awaiting Approval"/><ComboBoxItem Content="Approved"/><ComboBoxItem Content="Booking Pending"/><ComboBoxItem Content="Booked"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Cancelled"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="MONTH" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="MonthFilter" SelectionChanged="Filter_Changed"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="SELECT TRIP" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="TripFilter" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectionChanged="TripFilter_SelectionChanged"/></StackPanel>
    </Grid>
    <UniformGrid Columns="6" Margin="0,0,0,18">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UPCOMING" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="KUpcoming" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AWAITING" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="KAwaiting" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="APPROVED" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="KApproved" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BOOKED" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="KBooked" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COMPLETED" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="KCompleted" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="FILTERED" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="KFiltered" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource Card}" Padding="20">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0"><StackPanel><TextBlock x:Name="RouteText" Text="Select a trip" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="DateText" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Border x:Name="StatusBadge" DockPanel.Dock="Right" Background="{StaticResource PrimarySoft}" CornerRadius="14" Padding="12,6"><TextBlock x:Name="StatusText" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/></Border></DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,20,0,15">
          <StackPanel><TextBlock Text="TRAVELLERS" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="TravellerText" FontSize="15" TextWrapping="Wrap"/></StackPanel>
          <StackPanel><TextBlock Text="PAX" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="PaxText" FontSize="15"/></StackPanel>
          <StackPanel><TextBlock Text="HOTEL" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="HotelText" FontSize="15"/></StackPanel>
          <StackPanel><TextBlock Text="TRANSPORT" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="TransportText" FontSize="15" TextWrapping="Wrap"/></StackPanel>
        </UniformGrid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#F8FAFB" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="ONWARD" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="OnwardFlightText" FontSize="16" FontWeight="SemiBold" Margin="0,4"/><TextBlock x:Name="OnwardMetaText" Foreground="{StaticResource Muted}"/></StackPanel></Border>
          <Border Grid.Column="1" Background="#F8FAFB" CornerRadius="10" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="RETURN" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="ReturnFlightText" FontSize="16" FontWeight="SemiBold" Margin="0,4"/><TextBlock x:Name="ReturnMetaText" Foreground="{StaticResource Muted}"/></StackPanel></Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0"><StackPanel><TextBlock Text="NEXT ACTION" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="NextActionText" FontSize="15" FontWeight="SemiBold"/></StackPanel><StackPanel DockPanel.Dock="Right"><TextBlock Text="TOTAL COST" Style="{StaticResource SmallLabel}" HorizontalAlignment="Right"/><TextBlock x:Name="CostText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></DockPanel>
      </Grid>
    </Border>
    <TextBlock Text="NEXT 3 TRIPS" Style="{StaticResource SmallLabel}" Margin="2,7,0,7"/>
    <DataGrid x:Name="UpcomingGrid" Height="150"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding DepartureDate,StringFormat=dd-MMM}" Width="90"/><DataGridTextColumn Header="Route" Binding="{Binding RouteLabel}" Width="140"/><DataGridTextColumn Header="Travellers" Binding="{Binding Travellers}" Width="*"/><DataGridTextColumn Header="Pax" Binding="{Binding Pax}" Width="60"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/></DataGrid.Columns></DataGrid>
</StackPanel></ScrollViewer></UserControl>