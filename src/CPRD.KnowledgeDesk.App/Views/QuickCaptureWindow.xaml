<Window x:Class="CPRD.KnowledgeDesk.App.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Capture"
        Icon="{StaticResource AppIcon}"
        Width="560"
        Height="620"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="OnLoaded">
    <Grid Background="{StaticResource CanvasBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Quick Capture" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Save information now and organize it instantly."
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Folders}"
                          SelectedItem="{Binding SelectedFolder}"
                          DisplayMemberPath="Name"
                          Padding="7"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Note Type" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding NoteTypes}"
                          SelectedItem="{Binding SelectedNoteType}"
                          Padding="7"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Note" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding PlainText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="230"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="Tags (comma separated)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <CheckBox Content="Pin" IsChecked="{Binding IsPinned}" Margin="0,0,18,0"/>
            <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TealBrush}" Margin="18,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Background="{StaticResource CopperBrush}"
                    Foreground="White"
                    Padding="18,8"
                    Margin="0,0,8,0"/>
            <Button Content="Save &amp; Open"
                    Click="SaveAndOpen_Click"
                    Background="{StaticResource TealBrush}"
                    Foreground="White"
                    Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
