<Window x:Class="CPRD.KnowledgeDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CPRD.KnowledgeDesk.App.Views"
        Title="CPRD Knowledge Desk"
        Icon="{StaticResource AppIcon}"
        Width="1440"
        Height="880"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        SizeToContent="Manual">
    <DockPanel Background="{StaticResource CanvasBrush}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Note" Command="{Binding CreateNewNoteCommand}"/>
                <MenuItem Header="Quick _Note" Click="QuickCapture_Click"/>
                <Separator/>
                <MenuItem Header="_Import"/>
                <MenuItem Header="_Export"/>
                <MenuItem Header="_Backup"/>
                <MenuItem Header="_Restore"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo"/>
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo"/>
                <Separator/>
                <MenuItem Header="_Find" Command="ApplicationCommands.Find"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Dashboard" Command="{Binding RefreshDashboardCommand}"/>
                <MenuItem Header="Compact Mode"/>
                <MenuItem Header="Reading Mode"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Duplicate Finder"/>
                <MenuItem Header="Migration Center"/>
                <MenuItem Header="Backup Center"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Keyboard Shortcuts"/>
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PlumBrush}" CornerRadius="8" Width="34" Height="34" Padding="3">
                        <Image Source="{StaticResource AppIcon}" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="CPRD Knowledge Desk" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="Notes • Search • Organize • Find Anything"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="2" MaxWidth="640">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GlobalSearchBox"
                             Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search all notes (Ctrl+K)"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"
                            Background="{StaticResource LavenderBrush}" Foreground="White"
                            Padding="16,7" Margin="6,0,0,0"/>
                </Grid>

                <Button Grid.Column="3" Content="+ Quick Note" Margin="14,0,0,0"
                        Background="{StaticResource CopperBrush}" Foreground="White"
                        Padding="14,8" Click="QuickCapture_Click"/>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusText}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="Local database"/></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="210"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340" MinWidth="270"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="NAVIGATION" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="6,5,0,5"/>
                        <Button Style="{StaticResource NavButton}" Content="⌂  Dashboard"
                                Command="{Binding RefreshDashboardCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="⌕  All Notes"/>
                        <Button Style="{StaticResource NavButton}" Content="★  Favorites"/>
                        <Button Style="{StaticResource NavButton}" Content="●  Pinned"/>
                        <Button Style="{StaticResource NavButton}" Content="◷  Recent"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="FOLDERS" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="6,5,0,5"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButton}"
                                            Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▸" Foreground="{StaticResource LavenderBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="NOTES" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="4,4,0,7"/>
                        <Button Content="+ New Note" HorizontalAlignment="Stretch"
                                Background="{StaticResource TealBrush}" Foreground="White"
                                Margin="0,0,0,8"
                                Command="{Binding CreateNewNoteCommand}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}"
                                                Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding NoteId}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}"
                                                Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}">
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ModifiedAtUtc, StringFormat={}{0:g}}"
                                                           FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <Border Grid.Column="4" Background="{StaticResource CanvasBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding WorkspaceNotes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource LavenderSoftBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="2"
                                                Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Title}"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"/>
                                                <Button Content="×"
                                                        ToolTip="Close workspace note"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Padding="5,2"
                                                        Command="{Binding DataContext.CloseWorkspaceNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
                        <TabItem Header="Editor">
                            <views:EditorView DataContext="{Binding Editor}"/>
                        </TabItem>
                        <TabItem Header="Dashboard">
                            <views:DashboardView DataContext="{Binding Dashboard}"/>
                        </TabItem>
                        <TabItem Header="Trash">
                            <views:TrashView DataContext="{Binding Trash}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
