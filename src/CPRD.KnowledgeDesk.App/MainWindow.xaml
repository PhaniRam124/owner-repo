<Window x:Class="CPRD.KnowledgeDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CPRD.KnowledgeDesk.App.Views"
        Title="CPRD Knowledge Desk"
        Icon="{StaticResource AppIcon}"
        Width="1440"
        Height="880"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        SizeToContent="Manual">
    <DockPanel Background="{StaticResource CanvasBrush}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Note" Command="{Binding CreateNewNoteCommand}"/>
                <MenuItem Header="Quick _Note" Click="QuickCapture_Click"/>
                <Separator/>
                <MenuItem Header="_Import Notes..." Click="Import_Click"/>
                <MenuItem Header="_Export All Notes..." Click="Export_Click"/>
                <MenuItem Header="_Backup Now" Click="Backup_Click"/>
                <MenuItem Header="_Restore Backup..." Click="Restore_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo"/>
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo"/>
                <Separator/>
                <MenuItem Header="_Find" Click="Find_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Dashboard" Command="{Binding ShowDashboardCommand}"/>
                <MenuItem x:Name="CompactModeMenuItem"
                          Header="Compact Mode"
                          IsCheckable="True"
                          Click="CompactMode_Click"/>
                <MenuItem x:Name="ReadingModeMenuItem"
                          Header="Reading Mode"
                          IsCheckable="True"
                          Click="ReadingMode_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Duplicate Finder" Click="DuplicateFinder_Click"/>
                <MenuItem Header="Backup Folder" Click="OpenBackupsFolder_Click"/>
                <MenuItem Header="Open Data Folder" Click="OpenDataFolder_Click"/>
                <MenuItem Header="Open Diagnostic Logs" Click="OpenLogsFolder_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Keyboard Shortcuts" Click="KeyboardShortcuts_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PlumBrush}" CornerRadius="8" Width="34" Height="34" Padding="3">
                        <Image Source="{StaticResource AppIcon}" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="CPRD Knowledge Desk" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="Notes • Search • Organize • Find Anything"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="2" MaxWidth="640">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GlobalSearchBox"
                             Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search all notes (Ctrl+K, Enter to search)"
                             KeyDown="GlobalSearchBox_KeyDown"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"
                            Background="{StaticResource LavenderBrush}" Foreground="White"
                            Padding="16,7" Margin="6,0,0,0"/>
                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearSearchCommand}"
                            Padding="12,7" Margin="5,0,0,0"/>
                    <ComboBox Grid.Column="3"
                              Width="130"
                              Margin="5,0,0,0"
                              ItemsSource="{Binding RecentSearches}"
                              SelectionChanged="RecentSearches_SelectionChanged"
                              ToolTip="Recent searches"
                              VerticalContentAlignment="Center"/>
                </Grid>

                <Button Grid.Column="3" Content="+ Quick Note" Margin="14,0,0,0"
                        Background="{StaticResource CopperBrush}" Foreground="White"
                        Padding="14,8" Click="QuickCapture_Click"/>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem><TextBlock Text="{Binding StatusText}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="Database: Connected"/></StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Notes: "/>
                    <Run Text="{Binding Dashboard.TotalNotes}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="Autosave: On"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding Editor.SaveStatus}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Backup: "/>
                    <Run Text="{Binding Dashboard.BackupStatus}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="260" MinWidth="210"/>
                <ColumnDefinition x:Name="NavigationSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="NotesColumn" Width="340" MinWidth="270"/>
                <ColumnDefinition x:Name="NotesSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="WorkspaceColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="NAVIGATION" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="6,5,0,5"/>
                        <Button Style="{StaticResource NavButton}" Content="⌂  Dashboard"
                                Command="{Binding ShowDashboardCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="⌕  All Notes" Command="{Binding ShowAllNotesCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="★  Favorites" Command="{Binding ShowFavoritesCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="●  Pinned" Command="{Binding ShowPinnedCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="◷  Recent" Command="{Binding ShowRecentCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="▣  Archive" Command="{Binding ShowArchivedCommand}"/>
                        <Button Style="{StaticResource NavButton}" Content="♲  Trash" Command="{Binding ShowTrashCommand}"/>
                        <Separator Margin="0,8"/>
                        <DockPanel Margin="6,5,0,5">
                            <TextBlock Text="FOLDERS"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right"
                                    Content="+ Folder"
                                    Click="CreateFolder_Click"
                                    Padding="8,3"
                                    Margin="8,0,0,0"/>
                        </DockPanel>
                    </StackPanel>

                    <TreeView ItemsSource="{Binding FolderRoots}"
                              BorderThickness="0"
                              Background="Transparent"
                              VerticalContentAlignment="Center"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Button Style="{StaticResource NavButton}"
                                        Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"
                                        ToolTip="Right-click for folder actions">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="New Subfolder"
                                                      Tag="{Binding Folder}"
                                                      Click="CreateSubfolder_Click"/>
                                            <MenuItem Header="Rename"
                                                      Tag="{Binding Folder}"
                                                      Click="RenameFolder_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Archive Folder"
                                                      Tag="{Binding Folder}"
                                                      Click="ArchiveFolder_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <TextBlock Text="{Binding Name}"/>
                                </Button>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="4,4,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NOTES"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      Width="145"
                                      ItemsSource="{Binding NoteSortOptions}"
                                      SelectedItem="{Binding SelectedNoteSort, Mode=TwoWay}"
                                      ToolTip="Sort notes"
                                      VerticalContentAlignment="Center"/>
                        </Grid>
                        <Button Content="+ New Note" HorizontalAlignment="Stretch"
                                Background="{StaticResource TealBrush}" Foreground="White"
                                Margin="0,0,0,8"
                                Command="{Binding CreateNewNoteCommand}"/>
                        <TextBlock Text="{Binding EmptyStateText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="4,2,4,8"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}"
                                                Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding NoteId}">
                                            <StackPanel Margin="0,2">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               DockPanel.Dock="Left"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <TextBlock Text="★" Foreground="{StaticResource CopperBrush}" Margin="5,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="●" Foreground="{StaticResource PlumBrush}" Margin="5,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Snippet}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,2,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding FolderPath}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ModifiedAtUtc, StringFormat={}{0:g}}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               Margin="8,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NavButton}"
                                                Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}">
                                            <StackPanel Margin="0,2">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               DockPanel.Dock="Left"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <TextBlock Text="★" Foreground="{StaticResource CopperBrush}" Margin="5,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="●" Foreground="{StaticResource PlumBrush}" Margin="5,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding PlainText}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,2,0,2"/>
                                                <TextBlock Text="{Binding ModifiedAtUtc, StringFormat=Modified {0:g}}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <Border Grid.Column="4" Background="{StaticResource CanvasBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding WorkspaceNotes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource LavenderSoftBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="2"
                                                Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Title}"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"/>
                                                <Button Content="×"
                                                        ToolTip="Close workspace note"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Padding="5,2"
                                                        Command="{Binding DataContext.CloseWorkspaceNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TabControl x:Name="WorkspaceTabs"
                                Grid.Row="1"
                                BorderThickness="0"
                                Background="Transparent"
                                SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}">
                        <TabItem Header="Editor">
                            <views:EditorView x:Name="EditorPane" DataContext="{Binding Editor}"/>
                        </TabItem>
                        <TabItem Header="Dashboard">
                            <views:DashboardView DataContext="{Binding Dashboard}"/>
                        </TabItem>
                        <TabItem Header="Trash">
                            <views:TrashView DataContext="{Binding Trash}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
